{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "sourceRoot": "apps/docs/src",
  "tags": [],
  "implicitDependencies": ["forms-core", "forms-bootstrap", "forms-material", "forms-tailwind"],
  "targets": {
    "api": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/libs/*/src/**/*.ts",
        "{projectRoot}/scripts/generate-api.mjs",
        "{projectRoot}/tsconfig.typedoc.json"
      ],
      "outputs": ["{projectRoot}/src/generated"],
      "cache": true,
      "options": {
        "command": "node apps/docs/scripts/generate-api.mjs"
      }
    },
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "dependsOn": ["api"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/docs",
        "index": "apps/docs/src/index.html",
        "browser": "apps/docs/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/docs/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          { "glob": "**/*", "input": "apps/docs/public" },
          { "glob": "**/*.md", "input": "apps/docs/src/content", "output": "content" },
          { "glob": "api.json", "input": "apps/docs/src/generated", "output": "generated" },
          { "glob": "**/*.ts", "input": "apps/docs/src/app/demos", "output": "demo-src" }
        ],
        "styles": [
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "node_modules/bootstrap-icons/font/bootstrap-icons.css",
          "@angular/material/prebuilt-themes/azure-blue.css",
          "node_modules/highlight.js/styles/github.css",
          "apps/docs/src/tailwind.css",
          "apps/docs/src/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "1.5mb", "maximumError": "3mb" },
            { "type": "anyComponentStyle", "maximumWarning": "8kb", "maximumError": "16kb" }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "dependsOn": ["api"],
      "configurations": {
        "production": { "buildTarget": "docs:build:production" },
        "development": { "buildTarget": "docs:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
